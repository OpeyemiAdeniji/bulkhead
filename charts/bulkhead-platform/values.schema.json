{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "bulkhead-platform values",
  "type": "object",
  "additionalProperties": false,
  "required": ["platformAdmins", "exceptions", "kyverno", "runbookBaseURL"],
  "properties": {
    "platformAdmins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "users"],
      "properties": {
        "groups": {
          "description": "Kubernetes groups whose members may change platform objects.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^'\"\\\\]+$" }
        },
        "users": {
          "description": "Kubernetes user names that may change platform objects.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^'\"\\\\]+$" }
        }
      },
      "anyOf": [
        { "properties": { "groups": { "minItems": 1 } } },
        { "properties": { "users": { "minItems": 1 } } }
      ]
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }
      }
    },
    "kyverno": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "cleanupServiceAccount"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "cleanupServiceAccount": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" }
      }
    },
    "runbookBaseURL": { "type": "string", "pattern": "^https://[^'\"\\s]+[^/]$" }
  }
}
