{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "bulkhead-tenant values",
  "description": "Cluster-wide values of the tenant chart. The tenant file itself is checked by schemas/tenant.schema.json in continuous integration.",
  "type": "object",
  "required": ["name", "owner", "costCentre", "environment", "size", "access", "namespacePrefix", "podSecurity", "dns", "sizes", "containerDefaults"],
  "properties": {
    "namespacePrefix": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*-)?$",
      "maxLength": 32
    },
    "podSecurity": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "enum": ["restricted", "baseline"] }
      }
    },
    "dns": {
      "type": "object",
      "required": ["namespaceLabels", "podLabels", "ports", "extraCIDRs"],
      "properties": {
        "namespaceLabels": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "podLabels": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "ports": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "extraCIDRs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$" } }
      }
    },
    "sizes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["requests", "limits", "pods", "services", "persistentvolumeclaims"]
      }
    },
    "containerDefaults": {
      "type": "object",
      "required": ["request", "limit"]
    }
  }
}
