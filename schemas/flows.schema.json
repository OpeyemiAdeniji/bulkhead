{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpeyemiAdeniji/bulkhead/schemas/flows.schema.json",
  "title": "Declared flows for bulkhead check",
  "description": "Network flows a team expects to work or to be blocked, probed by bulkhead check --flows (docs/adr/0019-declared-flows-file.md). Every blocked flow also needs an allowed flow to the same destination; the checker enforces that rule, which a schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "flows"],
  "properties": {
    "apiVersion": { "const": "bulkhead.io/v1alpha1" },
    "kind": { "const": "Flows" },
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/flow" }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from", "to", "expect"],
      "properties": {
        "name": { "$ref": "#/$defs/dnsLabel", "description": "Identifies the flow in the reports. Unique within the file." },
        "description": { "type": "string", "maxLength": 500 },
        "from": { "$ref": "#/$defs/dnsLabel", "description": "The tenant namespace the probe starts from. It must be one of the tenants under test." },
        "via": {
          "description": "Labels of a running pod in the from namespace. The probe then runs inside that pod, in an ephemeral container, which needs --probe-workloads (docs/adr/0020-probes-from-workloads.md).",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 10,
          "propertyNames": {
            "maxLength": 253,
            "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?)?$"
          }
        },
        "to": { "$ref": "#/$defs/destination" },
        "expect": { "enum": ["allowed", "blocked"] }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "service": { "$ref": "#/$defs/dnsLabel" },
        "namespace": { "$ref": "#/$defs/dnsLabel" },
        "host": {
          "description": "A DNS name or an IP address.",
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "anyOf": [{ "format": "ipv4" }, { "format": "ipv6" }, { "format": "hostname" }]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "oneOf": [
        { "required": ["service", "namespace"], "not": { "required": ["host"] } },
        { "required": ["host"], "not": { "anyOf": [{ "required": ["service"] }, { "required": ["namespace"] }] } }
      ]
    }
  }
}
