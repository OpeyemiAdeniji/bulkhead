{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpeyemiAdeniji/bulkhead/blob/main/schemas/check-report.schema.json",
  "title": "bulkhead check report",
  "description": "The JSON report of one run of bulkhead check (bulkhead check -o json, or --report json=PATH). apiVersion v1alpha1 may change before v1.0 of Bulkhead; changes are announced in CHANGELOG.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "tool", "run", "tenants", "checks", "results", "summary", "exitCode"],
  "properties": {
    "apiVersion": { "const": "bulkhead.io/v1alpha1" },
    "kind": { "const": "CheckReport" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "const": "bulkhead" },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "startedAt", "finishedAt", "context", "server", "kubernetes", "user", "identitiesConfirmed"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{8}t[0-9]{6}-[0-9a-f]{8}$" },
        "mode": { "enum": ["live", "read-only", "dry-run"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "context": { "type": "string" },
        "server": { "type": "string" },
        "kubernetes": { "type": "string" },
        "user": { "type": "string" },
        "identitiesConfirmed": { "type": "boolean" },
        "interrupted": { "enum": ["interrupted", "timeout"] }
      }
    },
    "tenants": { "type": "array", "items": { "$ref": "#/$defs/tenant" } },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "results": { "type": "array", "items": { "$ref": "#/$defs/result" } },
    "requests": { "type": "array", "items": { "$ref": "#/$defs/request" } },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deleted"],
      "properties": {
        "deleted": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "policyReports": {
      "description": "The PolicyReport objects (wgpolicyk8s.io/v1alpha2) the run wrote into the cluster, with --policy-reports.",
      "type": "object",
      "additionalProperties": false,
      "required": ["written"],
      "properties": {
        "written": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" } },
        "leftOut": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail", "inconclusive", "error", "skipped", "notImplemented", "planned"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "notImplemented": { "type": "integer", "minimum": 0 },
        "planned": { "type": "integer", "minimum": 0 }
      }
    },
    "exitCode": {
      "description": "0: every selected check passed. 1: a check failed or was inconclusive. 2: usage error. 3: the checks could not run.",
      "enum": [0, 1, 2, 3]
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "groups": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "admin"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string", "minLength": 1 },
        "admin": { "$ref": "#/$defs/identity" },
        "viewer": { "$ref": "#/$defs/identity" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "level", "mode", "expect", "proves", "doesNotProve", "how", "fix"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
        "title": { "type": "string" },
        "category": { "enum": ["access", "guardrails", "admission", "network", "resources", "quota", "flows", "operators"] },
        "level": { "enum": ["basic", "hardened", "research"] },
        "mode": { "enum": ["read-only", "active"] },
        "expect": { "enum": ["allowed", "blocked"] },
        "pair": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
        "proves": { "type": "string" },
        "doesNotProve": { "type": "string" },
        "how": { "type": "string" },
        "fix": { "type": "string" },
        "references": {
          "description": "Items of published benchmarks the check tests (docs/benchmarks.md).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "id", "title", "relation"],
            "properties": {
              "source": { "enum": ["mtb", "cis", "nsa"] },
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "relation": { "enum": ["tests", "partly", "differs"] }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "status"],
      "properties": {
        "check": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
        "status": { "enum": ["pass", "fail", "inconclusive", "skipped", "error", "not-implemented", "planned"] },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "layer": {
          "description": "What decided a blocked request.",
          "enum": ["rbac", "pod-security", "admission", "quota", "limit-range", "network-policy", "resource-limits", "unknown"]
        },
        "duration": { "type": "string" },
        "from": { "description": "The source of a network result: a tenant namespace.", "type": "string" },
        "to": { "description": "The destination of a network result: a tenant namespace, dns or internet.", "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "kind", "as", "stores"],
      "properties": {
        "verb": { "type": "string" },
        "kind": { "type": "string" },
        "namespace": { "type": "string" },
        "name": { "type": "string" },
        "as": { "type": "string" },
        "stores": { "type": "boolean" },
        "check": { "type": "string" }
      }
    }
  }
}
